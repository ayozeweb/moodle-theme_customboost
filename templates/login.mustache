{{!
    @template theme_customboost/login

    Login page: an image panel with the site title and tagline, and the login form.
    On mobile the image is a band on top and the form slides over it as a sheet;
    from 992 px they sit side by side.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>"
        },
        "sitename": "Campus",
        "loginimage": "https://example.com/login.svg",
        "isdefaultimage": true,
        "logintitle": "Campus Demo",
        "logintagline": "Learn at your own pace, from any device.",
        "leftinstructions": ""
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="ct-login">
        <div id="page-content" class="ct-login-grid">
            <aside class="ct-login-media{{#isdefaultimage}} ct-login-media-default{{/isdefaultimage}}">
                <img class="ct-login-image" src="{{loginimage}}" alt="" width="1600" height="1100" fetchpriority="high" decoding="async">
                <div class="ct-login-media-content">
                    <span class="ct-login-brand">
                        <span class="ct-brand-mark" aria-hidden="true"></span>
                        <span>{{{sitename}}}</span>
                    </span>
                    <p class="ct-login-title">{{{logintitle}}}</p>
                    <p class="ct-login-tagline">{{{logintagline}}}</p>
                    {{#leftinstructions}}
                        <div class="ct-login-instructions d-none d-lg-block">{{{leftinstructions}}}</div>
                    {{/leftinstructions}}
                </div>
            </aside>
            <div id="region-main" class="ct-login-main">
                <div id="region-main-box" class="ct-login-sheet">
                    <div class="login-container">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
