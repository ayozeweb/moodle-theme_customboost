{{!
    @template theme_customboost/admin_preview

    Live preview of the appearance settings: the same components in the light and the dark preset.
    The theme_customboost/preview module fills the style element with CSS computed on the server.
    Nothing in it is interactive: links and buttons are inert and hidden from assistive technology
    except for the status line, which announces when the colours had to be adjusted.

    Example context (json):
    {
        "sitename": "Campus",
        "modes": [
            {"mode": "light", "label": "Light"},
            {"mode": "dark", "label": "Dark"}
        ]
    }
}}
<div class="ct-preview" data-region="ct-preview">
    <style data-region="ct-preview-style"></style>
    <p class="ct-preview-status" data-region="ct-preview-status" role="status" aria-live="polite"></p>
    <div class="ct-preview-panels" inert>
        {{#modes}}
            <div class="ct-preview-panel" data-bs-theme="{{mode}}" data-ct-preview-mode="{{mode}}" aria-hidden="true">
                <div class="ct-preview-label">{{label}}</div>
                <div class="ct-preview-bar">
                    <span class="ct-brand-mark"></span>
                    <span class="ct-preview-sitename">{{sitename}}</span>
                    <span class="ct-preview-pill">{{#str}}dashboard, theme_customboost{{/str}}</span>
                </div>
                <div class="ct-preview-body">
                    <h3 class="ct-preview-title">{{#str}}greeting, theme_customboost, Ana{{/str}}</h3>
                    <p class="ct-preview-text">{{#str}}greeting_subtitle, theme_customboost{{/str}} <a href="#">{{#str}}preview_link, theme_customboost{{/str}}</a>.</p>
                    <div class="ct-preview-buttons">
                        <span class="btn btn-primary">{{#str}}preview_button, theme_customboost{{/str}}</span>
                        <span class="btn btn-secondary">{{#str}}preview_secondary, theme_customboost{{/str}}</span>
                    </div>
                    <div class="alert alert-info mb-0">{{#str}}preview_alert, theme_customboost{{/str}}</div>
                    <div class="ct-course-card ct-preview-card">
                        <div class="ct-course-card-media ct-preview-card-media"></div>
                        <div class="ct-course-card-body">
                            <span class="ct-course-card-category">{{#str}}preview_category, theme_customboost{{/str}}</span>
                            <span class="ct-course-card-title">{{#str}}preview_course, theme_customboost{{/str}}</span>
                            <div class="ct-course-card-progress">
                                <div class="progress"><div class="progress-bar" style="width: 60%"></div></div>
                                <span class="ct-course-card-progress-text">{{#str}}preview_progress, theme_customboost{{/str}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {{/modes}}
    </div>
</div>
